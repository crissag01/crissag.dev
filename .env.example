# Almacenamiento de comentarios + rate limiting (Supabase)
# Se inyectan automáticamente al conectar la integración "Supabase" desde
# el dashboard de Vercel (Storage → Create Database). Para desarrollo
# local: `vercel link` y luego `vercel env pull .env.local`.
# SUPABASE_SERVICE_ROLE_KEY es server-only (bypassa RLS) — nunca exponerla
# con prefijo VITE_ ni usarla en código de frontend.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Email Configuration (usando Gmail o tu servicio)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contraseña-aplicacion
SMTP_FROM=tu-email@gmail.com
CONTACT_EMAIL=tu-email@gmail.com

# Cloudflare Turnstile (obtén en https://dash.cloudflare.com/?to=/:account/turnstile)
CLOUDFLARE_TURNSTILE_SECRET=tu-secret-key
VITE_CLOUDFLARE_TURNSTILE_SITEKEY=tu-site-key

# Moderación de comentarios (token largo y aleatorio, ej: openssl rand -hex 32)
# Requerido para usar GET /api/comments/pending, POST /api/comments/:id/approve y DELETE /api/comments/:id
ADMIN_TOKEN=genera-un-token-largo-y-aleatorio
